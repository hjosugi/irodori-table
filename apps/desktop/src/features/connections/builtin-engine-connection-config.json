{
  "scope": "builtinEngines",
  "defaultSettings": {
    "preferredMode": "fields",
    "urlLabelKey": "connection.field.urlDsn",
    "urlPlaceholder": "driver://user:password@host:port/database",
    "fieldsLabelKey": "connection.field.fields",
    "hostLabelKey": "connection.field.host",
    "hostPlaceholder": "localhost",
    "portLabelKey": "connection.field.port",
    "userLabelKey": "connection.field.user",
    "passwordLabelKey": "connection.field.password",
    "databaseLabelKey": "connection.field.database",
    "showHost": true,
    "showPort": true,
    "showUser": true,
    "showPassword": true,
    "transportLabelKey": "connection.transportTcp"
  },
  "engineSettings": [
    {
      "engines": [
        "postgres",
        "timescaledb",
        "neon",
        "cockroachdb",
        "yugabytedb",
        "redshift"
      ],
      "settings": {
        "urlPlaceholder": "postgres://user:password@host:5432/database",
        "databaseLabelKey": "connection.field.database"
      }
    },
    {
      "engines": ["mysql", "mariadb", "tidb"],
      "settings": {
        "urlPlaceholder": "mysql://user:password@host:3306/database"
      }
    },
    {
      "engines": ["sqlite"],
      "settings": {
        "preferredMode": "fields",
        "urlPlaceholder": "sqlite:///absolute/path/to/database.sqlite",
