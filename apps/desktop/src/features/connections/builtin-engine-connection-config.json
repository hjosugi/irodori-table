    },
    {
      "engines": ["sqlserver"],
      "settings": {
        "urlPlaceholder": "sqlserver://user:password@host:1433;databaseName=database",
        "hostLabelKey": "connection.field.server"
      }
    },
    {
      "engines": ["h2"],
      "settings": {
