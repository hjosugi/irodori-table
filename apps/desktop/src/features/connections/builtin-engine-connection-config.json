    },
    {
      "engines": ["cassandra", "scylladb"],
      "settings": {
        "urlPlaceholder": "cassandra://user:password@host:9042/keyspace",
        "databaseLabelKey": "connection.field.keyspace"
      }
    },
    {
      "engines": ["supabase"],
      "settings": {
        "urlPlaceholder": "postgres://postgres.<project-ref>:password@aws-0-<region>.pooler.supabase.com:6543/postgres",
